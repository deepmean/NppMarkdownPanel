<?xml version="1.0" encoding="utf-8"?>
<!--
  NppMarkdownPanel - ARM64 managed build.

  This project produces the managed half of the ARM64 plugin. It is an
  AnyCPU .NET Framework 4.7.2 assembly (the ARM64 CLR JITs the IL natively),
  built alongside a small native ARM64 shim (see arm64/NppShim.cpp) that
  Notepad++ loads and that hosts the CLR.

  Why a separate project instead of another configuration of
  NppMarkdownPanel.csproj: the x86/x64 build depends on
  UnmanagedExports.Repack.Upgrade to synthesise native exports at build time.
  That tooling only emits I386/AMD64/IA64 stubs and cannot be used for ARM64,
  so on ARM64 the export layer is the native shim instead. Keeping the two
  apart means neither build has to carry the other's machinery, and the
  x86/x64 release path stays byte-for-byte untouched.
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7C3E1A64-9F2B-4D58-A6E1-2B4C8D9E0F31}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>NppMarkdownPanel</RootNamespace>
    <!-- Distinct from the native shim's name on purpose: the shim is
         NppMarkdownPanel.dll (loaded by Notepad++) and this managed assembly is
         NppMarkdownPanel.Managed.dll (loaded by the shim, by full path). -->
    <AssemblyName>NppMarkdownPanel.Managed</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <TargetFrameworkProfile />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug-arm64\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release-arm64\</OutputPath>
